# Docker environment configuration
# Copy to docker/.env and customize for your setup

# Logging
RUST_LOG=info

# Database
ANAMNESIS_DB=/data/anamnesis

# Server
PORT=8080
BIND=0.0.0.0

# PostgreSQL (if using)
POSTGRES_DB=anamnesis
POSTGRES_USER=anamnesis
POSTGRES_PASSWORD=change_me_in_production

# LLM Provider (optional)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: Remote server configuration
# MCP_SERVER_URL=http://anamnesis:8080
# MCP_BEARER_TOKEN=your-bearer-token-here

# Optional: Storage configuration
# STORAGE_TYPE=sqlite  # or postgresql
# STORAGE_PATH=/data/anamnesis

# Development settings
DEBUG=false
RELOAD=true
