# Docker environment configuration
# Copy to docker/.env and customize for your setup.
#
# Every name below is one anamnesis or the compose file reads; a test fails
# the build when one is not. Names that are not read do nothing silently, and
# for a token that means a server left open by somebody who believes it closed.

# Logging (debug, info, warn, error)
RUST_LOG=info

# Where memory lives inside the container: wiki/, raw/, db/, models/, logs/
ANAMNESIS_DATA_DIR=/root/.anamnesis

# Require a bearer token on every route but /health. Mint one with
# `anamnesis token`; whatever runs the hooks sets the same value.
# ANAMNESIS_TOKEN=

# The address and port are not variables: override the container command,
#   anamnesis serve --bind 0.0.0.0 --port 9000

# A model for summaries (optional). Without one, pages are compiled by counting.
# ANAMNESIS_LLM_PROVIDER=google
# ANAMNESIS_LLM_MODEL=gemini-3.5-flash
# ANAMNESIS_LLM_API_KEY=
# ANTHROPIC_API_KEY=

# Vectors (optional)
# ANAMNESIS_EMBED_ENABLED=1
# ANAMNESIS_EMBED_PROVIDER=openai
# ANAMNESIS_EMBED_URL=http://ollama:11434/v1/embeddings
# ANAMNESIS_EMBED_MODEL=nomic-embed-text

# PostgreSQL, for the compose file's `postgres` profile only. Anamnesis does
# not use it: storage is SQLite in the data directory.
POSTGRES_PASSWORD=change_me_in_production
