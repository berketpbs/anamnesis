# Rust build artefacts
/target/
/companions/*/target/
/dist/
**/*.rs.bk
**/*.rs.orig

# Local environment overrides
.env
.env.local
/.local-data/

# Homelab deploy config — committed as .example variants only
/bin/deploy.env
/docker/docker-compose.prod.yml
/docker/.env.production

# Editor / OS noise
.DS_Store
*.tmp
*.swp
*.swo
.idea/
.vscode/
.vscode/settings.json

# Local debugging
*.log
flamegraph.svg
perf.data*

# Sandbox marker (not project content)
.ai-jail
.claude/
.slim/deepwork/
evals/runs/

# ai-memory atomic-write backups (apply_atomic in apply_shared.rs)
*.bak-*

# Node/Python build artefacts (if needed later)
node_modules/
*.egg-info/
.eggs/
*.egg
__pycache__/
*.pyc
*.pyo

# IDE and build artifacts
build/
dist/
.cargo/

# Temporary files
*~
*.tmp
npm-debug.log*

# OS files
Thumbs.db
*.o
*.so
*.dylib
*.dll

# MCP registration written by `anamnesis install-mcp --write`. It names an
# absolute path to a binary on one machine, so a checkout that inherited it
# would point at somebody else's home directory.
.mcp.json
