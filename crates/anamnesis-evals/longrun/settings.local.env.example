# A settings.env for the memory arm's server, for a repeat that should not
# depend on a hosted model's daily quota. Copy it somewhere and name it with
# `--settings-env`; without one, a run copies this machine's settings.env and
# the arm writes its pages with the model the real server uses.
#
# Why a repeat needs its own: the memory arm ends twelve sessions and each one
# is a consolidation request, the enrich pass asks again for every page that
# came back counted, and `key check` asks each link of the chain once — against
# a Google free tier of 20 requests per day per model, shared with whatever
# server is already running on the same key. On 2026-09-17 the first complete
# run had spent that by S10 and wrote its last three pages by counting; a
# repeat started four hours later wrote its first page that way.
#
# Ollama answers on this machine with no key and no quota. A session here is
# small — the consolidation input for one measured 3,888 tokens — so it fits a
# local model's window, which a real working session does not; that is why this
# machine's own server keeps a hosted model. The arm is then weaker than the
# real setup, so a difference it still shows is a floor rather than an estimate.
#
# Measured on 2026-09-17: S01 in the memory arm, run with these settings, came
# back `page model`, in about the same time, and spent no quota.
ANAMNESIS_LLM_PROVIDER=ollama
ANAMNESIS_LLM_MODEL=qwen2.5:7b-instruct
ANAMNESIS_LLM_MAX_OUTPUT_TOKENS=4000

# The embedder both setups already share.
ANAMNESIS_EMBED_ENABLED=1
ANAMNESIS_EMBED_PROVIDER=openai
ANAMNESIS_EMBED_URL=http://127.0.0.1:11434/v1/embeddings
ANAMNESIS_EMBED_MODEL=nomic-embed-text
