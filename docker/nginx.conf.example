# Nginx configuration for anamnesis reverse proxy
# Copy to docker/nginx.conf and customize.
#
# CI runs this file in front of the image and sends it what a hook sends, so
# what is written here is what was checked to work.

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript
               application/json application/javascript application/xml+rss;

    # Rate limiting
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=search_limit:10m rate=5r/s;

    upstream anamnesis {
        server anamnesis:8080;
    }

    server {
        listen 80;
        server_name _;

        # Redirect to HTTPS
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name anamnesis.local;

        # SSL configuration (update paths to your certificates)
        ssl_certificate /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        # The largest hook event the server reads is 16 MB — one Read of a big
        # file is already past nginx's default of 1 MB. Below the server's
        # limit, a large tool output is refused here with 413 and the hook
        # sets the event aside, so it is never recorded.
        client_max_body_size 16m;

        # Only what the server cannot know. It sets Content-Security-Policy,
        # X-Frame-Options, X-Content-Type-Options and Referrer-Policy itself,
        # and a second, different value from here (SAMEORIGIN beside its DENY)
        # is a conflict a browser may resolve by ignoring both. HSTS is the
        # proxy's, because TLS ends here.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # Search, with a tighter limit of its own. The route is
        # /api/v1/scopes/<workspace>/<project>/search, which no prefix
        # names, and a matching regular expression is chosen over /api/.
        location ~ ^/api/v1/scopes/[^/]+/[^/]+/search$ {
            limit_req zone=search_limit burst=10;
            proxy_pass http://anamnesis;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # API endpoints
        location /api/ {
            limit_req zone=api_limit burst=20;
            proxy_pass http://anamnesis;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Hooks, handoffs and the wiki browser. Not rate limited: a session's
        # hooks arrive in bursts, one per tool call, and a hook refused here
        # is an event lost.
        location / {
            proxy_pass http://anamnesis;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
        }

        # Health check endpoint (don't log)
        location /health {
            access_log off;
            proxy_pass http://anamnesis;
        }

        # Status page (nginx internal)
        location /nginx_status {
            stub_status on;
            access_log off;
            allow 127.0.0.1;
            deny all;
        }
    }
}
